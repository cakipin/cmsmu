export const postsPage = `
<div x-show="view === 'posts'" class="animate-fade"
     x-data="{
        selectedIds: [],
        quickEditId: null,
        quickForm: {},
        
        formatDateID(dateString) {
            if (!dateString) return '-';
            const date = new Date(dateString);
            if (isNaN(date.getTime())) return '-';
            return date.toLocaleDateString('id-ID', {
                day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
            }).replace('.', ':');
        },

        toggleAll() {
            this.selectedIds = (this.selectedIds.length === this.posts.length) ? [] : this.posts.map(p => p.id);
        },

        async executeBulk(action) {
            if (this.selectedIds.length === 0) return alert('Pilih minimal satu artikel.');
            if (!confirm('Yakin hapus ' + this.selectedIds.length + ' item terpilih?')) return;

            if (action === 'delete') {
                for (let id of this.selectedIds) {
                    await fetch('/api/posts?id=' + id, { 
                        method: 'DELETE', 
                        headers: { 'Authorization': 'Bearer ' + token }
                    });
                }
                if(window.cms().loadPosts) await window.cms().loadPosts();
                this.selectedIds = [];
            }
        },

        openQuickEdit(item) {
            this.quickEditId = item.id;
            this.quickForm = JSON.parse(JSON.stringify(item));
        },
        
        async saveQuickEdit() {
            if(!this.quickForm.slug) this.quickForm.slug = window.slugify(this.quickForm.title);

            try {
                const res = await fetch('/api/posts?id=' + this.quickForm.id, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify(this.quickForm)
                });
                
                if (res.ok) {
                    const index = this.posts.findIndex(p => p.id === this.quickForm.id);
                    if (index !== -1) {
                        this.posts[index] = { ...this.posts[index], ...this.quickForm };
                    }
                    this.quickEditId = null;
                } else {
                    const err = await res.json();
                    alert('Gagal simpan: ' + (err.message || 'Error API'));
                }
            } catch(e) { 
                console.error(e);
                alert('Gagal koneksi ke server.');
            }
        }
     }">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
        <h2 style="margin:0; font-size:1.5rem; color:#1d2327;">Semua Artikel</h2>
        <button @click="openEditor('post')" class="btn btn-primary" style="background:#2271b1; border:none; color:white; padding:8px 15px; border-radius:3px; font-weight:600; cursor:pointer;">
            Tambah Baru
        </button>
    </div>

    <div style="margin-bottom:15px; display:flex; gap:10px; align-items:center;">
        <select id="bulk-action-selector" style="padding:5px; border:1px solid #8c8f94; border-radius:3px; color:#2c3338;">
            <option value="">Tindakan Massal</option>
            <option value="delete">Hapus Permanen</option>
        </select>
        <button @click="executeBulk(document.getElementById('bulk-action-selector').value)" 
                class="btn" style="padding:5px 10px; border:1px solid #8c8f94; background:#f6f7f7; color:#2c3338; border-radius:3px; cursor:pointer;">
            Terapkan
        </button>
    </div>

    <div style="background:white; border:1px solid #c3c4c7; box-shadow:0 1px 1px rgba(0,0,0,0.04);">
        <table style="width:100%; border-collapse:collapse; text-align:left;">
            <thead style="background:#f0f0f1; border-bottom:1px solid #c3c4c7;">
                <tr>
                    <th style="padding:8px; width:30px; text-align:center;"><input type="checkbox" @change="toggleAll()"></th>
                    <th style="padding:8px; font-weight:600; color:#2c3338;">Judul</th>
                    <th style="padding:8px; font-weight:600; color:#2c3338;">Penulis</th>
                    <th style="padding:8px; font-weight:600; color:#2c3338;">Kategori</th>
                    <th style="padding:8px; font-weight:600; color:#2c3338;">Tag</th>
                    <th style="padding:8px; font-weight:600; color:#2c3338;">Tanggal</th>
                </tr>
            </thead>

            <tbody>
                <template x-for="item in posts" :key="item.id">
                    <template x-for="i in [1]">
                        <React.Fragment> <tr x-show="quickEditId !== item.id" class="wp-row-hover" style="background:white; border-bottom:1px solid #f0f0f1;">
                                <td style="padding:8px; text-align:center; vertical-align:top;">
                                    <input type="checkbox" :value="item.id" x-model="selectedIds">
                                </td>
                                
                                <td style="padding:8px; vertical-align:top;">
                                    <div style="font-weight:600; font-size:14px; margin-bottom:4px;">
                                        <a :href="'/' + item.slug" target="_blank" style="text-decoration:none; color:#2271b1;" x-text="item.title || '(Tanpa Judul)'"></a>
                                        <span x-show="item.status !== 'publish'" x-text="' — ' + item.status" style="font-weight:bold; color:#50575e; font-size:11px;"></span>
                                    </div>
                                    
                                    <div class="row-actions" style="font-size:11px; color:#ddd;">
                                        <button @click="editContent(item)" style="background:none; border:none; padding:0; color:#2271b1; cursor:pointer;">Edit</button>
                                        <span>|</span>
                                        <button @click="openQuickEdit(item)" style="background:none; border:none; padding:0; color:#2271b1; cursor:pointer;">Edit Cepat</button>
                                        <span>|</span>
                                        <button @click="deleteContent(item.id, 'post')" style="background:none; border:none; padding:0; color:#a00; cursor:pointer;">Hapus</button>
                                        <span>|</span>
                                        <a :href="'/' + item.slug" target="_blank" style="text-decoration:none; color:#2271b1;">Tampil</a>
                                    </div>
                                </td>

                                <td style="padding:8px; font-size:13px; color:#50575e; vertical-align:top;">Admin</td>
                                <td style="padding:8px; font-size:13px; color:#50575e; vertical-align:top;" x-text="item.category || '—'"></td>
                                <td style="padding:8px; font-size:13px; color:#50575e; vertical-align:top;" x-text="item.tags || '—'"></td>
                                <td style="padding:8px; font-size:13px; color:#50575e; vertical-align:top;">
                                    <div x-text="item.status === 'publish' ? 'Diterbitkan' : 'Terakhir Diubah'"></div>
                                    <div x-text="formatDateID(item.date || item.created_at)"></div>
                                </td>
                            </tr>

                            <tr x-show="quickEditId === item.id" style="background:#f9f9f9; box-shadow:inset 0 0 5px rgba(0,0,0,0.1); border-bottom:1px solid #ddd;">
                                <td colspan="6" style="padding:10px 15px; border-left:4px solid #2271b1;">
                                    <h4 style="margin:0 0 10px 0; font-size:12px; font-weight:600;">EDIT CEPAT</h4>
                                    
                                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:15px; margin-bottom:10px;">
                                        <div>
                                            <label style="display:block; font-size:12px; margin-bottom:3px;">Judul</label>
                                            <input type="text" x-model="quickForm.title" class="form-input">
                                        </div>
                                        <div>
                                            <label style="display:block; font-size:12px; margin-bottom:3px;">Slug</label>
                                            <input type="text" x-model="quickForm.slug" class="form-input">
                                        </div>
                                        <div>
                                            <label style="display:block; font-size:12px; margin-bottom:3px;">Tanggal</label>
                                            <input type="text" x-model="quickForm.date" placeholder="YYYY-MM-DD HH:mm" class="form-input">
                                        </div>
                                    </div>
                                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:15px; margin-bottom:10px;">
                                        <div>
                                            <label style="display:block; font-size:12px; margin-bottom:3px;">Kategori</label>
                                            <input type="text" x-model="quickForm.category" class="form-input">
                                        </div>
                                        <div>
                                            <label style="display:block; font-size:12px; margin-bottom:3px;">Status</label>
                                            <select x-model="quickForm.status" class="form-input">
                                                <option value="publish">Diterbitkan</option>
                                                <option value="draft">Draft</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div style="display:flex; justify-content:flex-end; gap:8px;">
                                        <button @click="quickEditId = null" class="btn" style="background:white; border:1px solid #c3c4c7; font-size:11px; padding:4px 10px; cursor:pointer;">Batal</button>
                                        <button @click="saveQuickEdit()" class="btn btn-primary" style="background:#2271b1; color:white; border:none; font-size:11px; padding:4px 10px; border-radius:3px; cursor:pointer;">Perbarui</button>
                                    </div>
                                </td>
                            </tr>
                        </React.Fragment>
                    </template>
                </template>
                
                <template x-if="posts.length === 0 && !isLoadingPosts">
                    <tr>
                        <td colspan="6" style="padding:50px; text-align:center; color:#646970;">
                            Belum ada artikel ditemukan.
                        </td>
                    </tr>
                </template>
            </tbody>
        </table>
    </div>

    <style>
        .row-actions { visibility: hidden; opacity: 0; transition: 0.1s; }
        .wp-row-hover:hover .row-actions { visibility: visible; opacity: 1; }
        .form-input { width:100%; padding:5px; border:1px solid #8c8f94; border-radius:3px; font-size:13px; }
    </style>
</div>
`;