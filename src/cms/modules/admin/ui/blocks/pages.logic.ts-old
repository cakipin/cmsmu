export const pagesLogic = `
    pages: [],
    isLoadingPages: false,

    async loadPages() {
        this.isLoadingPages = true;
        try {
            const res = await fetch('/api/contents?type=page', {
                headers: { 
                    'Authorization': this.token || '',
                    'Content-Type': 'application/json'
                }
            });
            
            if (!res.ok) throw new Error('Failed to fetch pages');

            const json = await res.json();
            const rawData = json.data || json || [];
            
            this.pages = Array.isArray(rawData) ? rawData : [];
            
        } catch (e) {
            console.error("Error loading pages:", e);
            this.pages = [];
        } finally {
            this.isLoadingPages = false;
        }
    },

    async deletePage(id) {
        if(!confirm('Yakin ingin menghapus halaman ini?')) return;
        try {
            const res = await fetch('/api/contents/' + id, {
                method: 'DELETE',
                headers: { 'Authorization': this.token }
            });
            if(res.ok) {
                this.pages = this.pages.filter(p => p.id !== id);
                alert('Halaman berhasil dihapus');
            } else {
                alert('Gagal menghapus halaman');
            }
        } catch(e) { alert('Error network'); }
    }
`;