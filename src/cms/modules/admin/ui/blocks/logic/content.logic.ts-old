import { coreLogic } from './core.logic';

export const contentLogic = {
    // =========================================
    // CONTENT MANAGER LOGIC
    // =========================================
    
    async loadPosts() {
        this.isLoadingPosts = true;
        try {
            const res = await fetch('/api/contents?type=post', { headers: { 'Authorization': 'Bearer ' + this.token } });
            const json = await res.json();
            this.posts = Array.isArray(json) ? json : (json.data || json.results || []);
            console.log('✅ Loaded posts:', this.posts.length);
        } catch (e) { 
            console.error('Error loadPosts:', e); 
            this.posts = []; 
        } finally { this.isLoadingPosts = false; }
    },

    async loadPages() {
        this.isLoadingPages = true;
        try {
            const res = await fetch('/api/contents?type=page', { headers: { 'Authorization': 'Bearer ' + this.token } });
            const json = await res.json();
            this.pages = Array.isArray(json) ? json : (json.data || json.results || []);
        } catch (e) { this.pages = []; } 
        finally { this.isLoadingPages = false; }
    },

    async saveContent() {
        if (!this.form.title) { alert('Judul wajib diisi!'); return; }
        
        // Ambil Sanitizer dari window
        const cleanData = window.cleanFormData ? window.cleanFormData(this.form) : this.form;
        
        try {
            const res = await fetch('/api/contents', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + this.token },
                body: JSON.stringify(cleanData)
            });

            if (res.ok) {
                alert('Berhasil disimpan!');
                await this.loadPosts();
                await this.loadPages();
                this.view = (cleanData.type === 'post' ? 'posts' : 'pages');
            } else {
                const text = await res.text();
                try { const json = JSON.parse(text); alert('Gagal: ' + json.error); } 
                catch(e) { alert('Gagal simpan.'); }
            }
        } catch (e) { alert('Gagal koneksi.'); }
    },

    async deleteContent(id, type) {
        if (!confirm('Yakin hapus?')) return;
        const res = await fetch('/api/contents?id=' + id, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + this.token } });
        if (res.ok) { 
            await this.loadPosts(); 
            await this.loadPages(); 
        }
    },
    
    toggleSelectAll() {
        if (!this.posts) return;
        this.selectedItems = (this.selectedItems.length === this.posts.length) ? [] : this.posts.map(p => p.id);
    },
    
    formatDate(dateStr) {
        if(!dateStr) return '-';
        return new Date(dateStr).toLocaleDateString('id-ID', {
            day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute:'2-digit'
        });
    },

    get dashboardStats() {
        return {
            posts: (this.posts || []).length,
            pages: (this.pages || []).length,
            media: (this.mediaList || []).length,
        };
    }
};

// ⚡ AUTO-INJECTOR ⚡
if (typeof coreLogic !== 'undefined') {
    Object.assign(coreLogic, contentLogic);
    
    // Backup Global
    window.loadPosts = contentLogic.loadPosts;
    window.loadPages = contentLogic.loadPages;
    window.saveContent = contentLogic.saveContent;
    window.deleteContent = contentLogic.deleteContent;
    
    console.log('✅ Content Logic Injected into Core & Window');
}